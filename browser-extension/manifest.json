{
  "manifest_version": 3,
  "name": "UniHub ILIAS Bridge",
  "version": "0.1.0",
  "description": "Überträgt angemeldete ILIAS-Seiten an UniHub.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://ilias3.uni-stuttgart.de/*",
    "http://127.0.0.1:43127/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "UniHub",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ilias3.uni-stuttgart.de/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}